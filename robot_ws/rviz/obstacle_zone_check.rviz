Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Map
      Name: explore_map
      Enabled: true
      Topic:
        Value: /explore_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
    - Class: rviz_default_plugins/Map
      Name: obstacle_zone (청소 불가 구역)
      Enabled: true
      Topic:
        Value: /coverage_obstacle_zone_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.6
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/Path
      Name: coverage_path
      Enabled: true
      Topic:
        Value: /coverage_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 25; 255; 0
    - Class: rviz_default_plugins/Path
      Name: coverage_active_path
      Enabled: true
      Topic:
        Value: /coverage_active_path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 255; 0; 255
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Enabled: true
Window Geometry:
  Displays:
    collapsed: false
