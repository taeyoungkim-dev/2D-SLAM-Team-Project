# server/.env.example
# 이 파일을 복사해서 server/.env 로 만들고 값을 채운 뒤 사용하세요.
# (python-dotenv 를 쓰지 않는다면, 아래 값들을 shell export 로 대신 설정해도 됩니다.)

# 서버가 바인딩할 호스트/포트
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 앱/로봇에게 이미지 URL을 만들어줄 때 쓰는 이 PC의 LAN IP.
# 데모 당일 `ip addr` / `ifconfig` 로 확인한 실제 IP로 바꿔주세요.
SERVER_PUBLIC_BASE_URL=http://192.168.0.10:8000

# SQLite DB 파일 경로 (기본값: server/data/app.db)
SERVER_DB_PATH=./data/app.db

# 로봇 telemetry 타임아웃(초) - 이 시간 이상 소식이 없으면 연결 끊김으로 간주
ROBOT_TIMEOUT_SEC=5.0
